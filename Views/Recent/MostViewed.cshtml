@using MediaManager.Models
@model List<MediaManager.Controllers.RecentController.Item>
@{
    ViewBag.Title = "Most Viewed";
    int days = ViewBag.Days;
    Func<int, string> dayLabel = d => d == 7 ? "Last week" : d == 30 ? "Last month" : "All time";
}

<h2>Most Viewed</h2>
<p style="opacity:.8;">
    The files whose pages were opened most. Opening the same file again in the same browser within 30 minutes doesn't
    count twice. @Html.ActionLink("Recently Added", "Index")
</p>

<style>
    .rc-filters { margin: 10px 0 16px; display: flex; gap: 8px; flex-wrap: wrap; }
    .rc-filters a { padding: 4px 12px; border: 1px solid rgba(127,127,127,.5); border-radius: 14px; text-decoration: none; }
    .rc-filters a.active { background: #2a7ae2; border-color: #2a7ae2; color: #fff; }
    .rc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .rc-item { text-decoration: none; color: inherit; display: block; }
    .rc-thumb {
        height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden;
        border-radius: 6px; background: rgba(127,127,127,.15); font-size: 40px; position: relative;
    }
    .rc-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .rc-play { position: absolute; font-size: 26px; color: #fff; text-shadow: 0 0 6px rgba(0,0,0,.8); }
    .rc-rank {
        position: absolute; top: 6px; left: 6px; padding: 1px 8px; border-radius: 10px; font-size: 12px;
        background: rgba(0,0,0,.65); color: #fff;
    }
    .rc-name { font-size: 13px; margin-top: 4px; word-break: break-all; line-height: 1.25; }
    .rc-meta { font-size: 12px; opacity: .7; word-break: break-all; }
</style>

<div class="rc-filters">
    @foreach (int d in MediaManager.Controllers.RecentController.ViewDayChoices)
    {
        <a href="@Url.Action("MostViewed", new { days = d })" class="@(d == days ? "active" : "")">@dayLabel(d)</a>
    }
</div>

@if (!Model.Any())
{
    <p>Nothing viewed @(days == 0 ? "yet" : "in the " + dayLabel(days).ToLowerInvariant()).</p>
}
else
{
    <div class="rc-grid">
        @for (int n = 0; n < Model.Count; n++)
        {
            var i = Model[n];
            <a class="rc-item" href="@Url.ViewLink(i.Folder, i.Name)" title="@i.Name">
                <div class="rc-thumb">
                    @if (i.Thumb != null)
                    {
                        <img src="@i.Thumb" loading="lazy" alt="" />
                    }
                    else if (i.Kind == MediaKind.Image)
                    {
                        <img src="@i.Url" loading="lazy" alt="" />
                    }
                    else
                    {
                        @MediaKind.Icon(i.Name)
                    }
                    @if (i.Kind == MediaKind.Video && i.Thumb != null)
                    {
                        <span class="rc-play">&#9654;</span>
                    }
                    <span class="rc-rank">#@(n + 1)</span>
                </div>
                <div class="rc-name">@i.Name</div>
                <div class="rc-meta">
                    @i.Views.ToString("N0") view@(i.Views == 1 ? "" : "s") &middot; @(i.Folder.Length == 0 ? "(top folder)" : i.Folder)
                    <br />last @i.Added.ToString("MMM d, HH:mm")
                </div>
            </a>
        }
    </div>
}
