@using MediaManager.Models
@model List<ActivityLog.Entry>
@{
    ViewBag.Title = "Activity";
    bool errorsOnly = ViewBag.Errors == true;
    int pageSize = ViewBag.PageSize;

    Func<string, string> label = kind =>
    {
        switch (kind)
        {
            case ActivityLog.Upload: return "Upload";
            case ActivityLog.Delete: return "Delete";
            case ActivityLog.Rename: return "Rename";
            case ActivityLog.Move: return "Move";
            case ActivityLog.Copy: return "Copy";
            case ActivityLog.Tags: return "Tags";
            case ActivityLog.Fix: return "Fix";
            case ActivityLog.Playable: return "AVI copy";
            case ActivityLog.Duplicates: return "Duplicates";
            case ActivityLog.RecycleBin: return "Recycle Bin";
            case ActivityLog.Login: return "Login";
            case ActivityLog.Server: return "Server";
            case ActivityLog.Guestbook: return "Guestbook";
            case ActivityLog.Download: return "Download";
            case ActivityLog.Hidden: return "Hidden folder";
            case ActivityLog.Favorites: return "Favorites";
            default: return kind;
        }
    };
}

<h2>Activity</h2>
<p style="opacity:.8;">
    What the site has done lately, newest first: uploads, downloads, moves, renames, deletes, fixes, AVI copies,
    duplicate scans, Recycle Bin changes, favorites, hidden folders, logins, and anything that went wrong on the server.
    Kept for @ActivityLog.KeepDays days.
</p>

@{ var summary = ViewBag.Summary as ActivityLog.Summary; }
@if (summary != null)
{
    Func<string, int> n = k => summary.ByKind.TryGetValue(k, out int c) ? c : 0;
    Func<int, string, string> plural = (c, word) => c.ToString("N0") + " " + word + (c == 1 ? "" : "s");
    <div class="act-summary">
        <h4>Last @summary.Days days</h4>
        <div class="act-stats">
            <div><b>@n(ActivityLog.Upload).ToString("N0")</b><span>uploads</span></div>
            <div><b>@n(ActivityLog.Download).ToString("N0")</b><span>downloads</span></div>
            <div><b>@summary.Views.ToString("N0")</b><span>views</span></div>
            <div><b>@(n(ActivityLog.Delete) + n(ActivityLog.Duplicates))</b><span>deletes</span></div>
            <div><b>@summary.OwnerLogins</b><span>owner logins</span></div>
            <div><b>@summary.GuestLogins</b><span>guest logins</span></div>
            <div class="@(summary.WrongPasswords > 0 ? "act-warn" : "")"><b>@summary.WrongPasswords</b><span>wrong passwords</span></div>
            <div class="@(summary.Errors > 0 ? "act-warn" : "")"><b>@summary.Errors</b><span>errors</span></div>
        </div>
        @if (summary.WrongPasswords > 0)
        {
            <p>
                Wrong passwords came from @plural(summary.WrongPasswordIps.Count, "address"): @string.Join(", ", summary.WrongPasswordIps.Take(8))@(summary.WrongPasswordIps.Count > 8 ? ", …" : "").
                @if (LoginThrottle.SiteWideLimitReached)
                {
                    <b>The site-wide limit is on now</b><text> (@LoginThrottle.SiteWideLimit or more in the last hour): every device gets one try before it has to wait.</text>
                }
            </p>
        }
        @if (summary.LoginIps.Any())
        {
            <p>Logged in from: @string.Join(", ", summary.LoginIps.Take(8))@(summary.LoginIps.Count > 8 ? ", …" : "").</p>
        }
        @if (summary.TopViewed.Any())
        {
            <p>
                Most viewed:
                @for (int i = 0; i < summary.TopViewed.Count; i++)
                {
                    var t = summary.TopViewed[i];
                    <a href="@Url.ViewLink(t.Folder, t.FileName)">@t.FileName</a><text> (@t.Views)</text>@(i < summary.TopViewed.Count - 1 ? ", " : "")
                }
                &middot; @Html.ActionLink("more", "MostViewed", "Recent", new { days = 7 }, null)
            </p>
        }
    </div>
}

@if (TempData["SignOutMessage"] != null)
{
    <div class="alert alert-success">@TempData["SignOutMessage"]</div>
}
@if (TempData["SignOutError"] != null)
{
    <div class="alert alert-danger">@TempData["SignOutError"]</div>
}

@{
    var logins = ViewBag.Logins as List<ActiveLogins.Login> ?? new List<ActiveLogins.Login>();
    string currentLogin = ViewBag.CurrentLoginId as string;
    Func<DateTime, string> ago = utc =>
    {
        var span = DateTime.UtcNow - utc;
        return span.TotalMinutes < 2 ? "just now"
            : span.TotalHours < 1 ? (int)span.TotalMinutes + " min ago"
            : span.TotalDays < 1 ? (int)span.TotalHours + " h ago"
            : utc.ToLocalTime().ToString("MMM d, HH:mm");
    };
}
<h4 style="margin-top:18px;">Logged in now</h4>
@if (!logins.Any())
{
    <p style="opacity:.8;">Nobody else is logged in (or the list will start filling in as devices load pages).</p>
}
else
{
    <table class="table table-condensed act-table" style="margin-bottom:8px;">
        <thead><tr><th>Who</th><th>Device</th><th>Logged in</th><th>Last seen</th><th></th></tr></thead>
        <tbody>
            @foreach (var l in logins)
            {
                bool me = l.LoginId == currentLogin;
                <tr>
                    <td class="act-who">@l.Role<br /><small>@l.Ip</small></td>
                    <td title="@l.Browser">@ActiveLogins.DescribeBrowser(l.Browser)@if (me) { <text> </text><span class="act-kind">this device</span> }</td>
                    <td class="act-time" title="@l.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@ago(l.StartedAt)</td>
                    <td class="act-time" title="@l.LastSeenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@ago(l.LastSeenAt)</td>
                    <td>
                        @if (!me)
                        {
                            using (Html.BeginForm("EndLogin", "Activity", FormMethod.Post, new { style = "margin:0;",
                                onsubmit = "return confirm('Log this device out? It will have to enter the password again.');" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@l.LoginId" />
                                <button type="submit" class="btn btn-default btn-xs">Log out</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@using (Html.BeginForm("SignOutEverywhere", "Activity", FormMethod.Post, new { style = "margin-bottom:10px;",
    onsubmit = "return confirm('Log out every other device, and any guests? They will have to enter the password again. You stay logged in here.');" }))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-default btn-sm"
            title="Ends every login on every other device, owner and guests. Use it if a device is lost or a password got out (and change that password too).">
        Log out all other devices
    </button>
    if (MediaAccess.SignedOutBeforeUtc != DateTime.MinValue)
    {
        <small style="opacity:.75; margin-left:8px;">Last done @MediaAccess.SignedOutBeforeUtc.ToLocalTime().ToString("MMM d, HH:mm")</small>
    }
}

<style>
    .act-filters { margin: 10px 0 15px; display: flex; gap: 8px; flex-wrap: wrap; }
    .act-filters a { padding: 4px 12px; border: 1px solid rgba(127,127,127,.5); border-radius: 14px; text-decoration: none; }
    .act-filters a.active { background: #2a7ae2; border-color: #2a7ae2; color: #fff; }
    .act-table td { vertical-align: top; }
    .act-time { white-space: nowrap; opacity: .8; }
    .act-kind { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; background: rgba(127,127,127,.2); white-space: nowrap; }
    .act-error td { background: rgba(217,83,79,.12); }
    .act-error .act-kind { background: #d9534f; color: #fff; }
    .act-file { word-break: break-all; }
    .act-file small { opacity: .75; }
    .act-msg { word-break: break-word; }
    .act-who { white-space: nowrap; }
    .act-who small { opacity: .75; }
    .act-summary { margin: 12px 0 18px; padding: 12px 15px; border: 1px solid rgba(127,127,127,.35); border-radius: 6px; }
    .act-summary h4 { margin: 0 0 10px; }
    .act-summary p { margin: 8px 0 0; word-break: break-word; }
    .act-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
    .act-stats div { padding: 6px 8px; border-radius: 6px; background: rgba(127,127,127,.12); }
    .act-stats b { display: block; font-size: 20px; }
    .act-stats span { font-size: 12px; opacity: .8; }
    .act-stats .act-warn { background: rgba(217,83,79,.15); }
</style>

<div class="act-filters">
    <a href="@Url.Action("Index")" class="@(errorsOnly ? "" : "active")">Everything</a>
    <a href="@Url.Action("Index", new { errors = true })" class="@(errorsOnly ? "active" : "")">Errors only</a>
</div>

@if (ViewBag.LoadError != null)
{
    <div class="alert alert-warning">
        Couldn't read the activity log. If the site was just updated, its database may need SQL\Schema.sql applied
        (<code>deploy\Setup-Database.ps1</code>).<br /><small>@ViewBag.LoadError</small>
    </div>
}
else if (!Model.Any())
{
    <p>@(errorsOnly ? "No errors logged." : "Nothing logged yet.")</p>
}
else
{
    <table class="table table-condensed act-table">
        <thead>
            <tr><th>When</th><th>What</th><th>Who</th><th>File</th><th>Details</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr class="@(e.IsError ? "act-error" : "")">
                    <td class="act-time" title="@e.At.ToString("yyyy-MM-dd HH:mm:ss")">@e.At.ToString("MMM d, HH:mm")</td>
                    <td><span class="act-kind">@label(e.Kind)@(e.IsError ? " error" : "")</span></td>
                    <td class="act-who">
                        @* Role and IP address of the device (blank for the server's own entries and older entries) *@
                        @(e.Role ?? (e.Ip != null ? "—" : ""))
                        @if (e.Ip != null)
                        {
                            <br /><small>@e.Ip</small>
                        }
                    </td>
                    <td class="act-file">
                        @if (e.FileName != null && e.Folder != null)
                        {
                            <a href="@Url.ViewLink(e.Folder, e.FileName)">@e.FileName</a>
                            <br /><small>@(e.Folder.Length == 0 ? "(top folder)" : e.Folder)</small>
                        }
                    </td>
                    <td class="act-msg">@e.Message</td>
                </tr>
            }
        </tbody>
    </table>

    if (Model.Count == pageSize)
    {
        <p>@Html.ActionLink("Older entries →", "Index", new { before = Model.Last().ActivityId, errors = errorsOnly ? (bool?)true : null })</p>
    }
}
