@{
    ViewBag.Title = "Home";
    // Deliberately does no disk or database work so the app opens instantly;
    // the full folder list lives on the Folders page.
    var tiles = new List<Tuple<string, string, string>>
    {
        Tuple.Create("Folders", Url.Action("Folders", "Home"), "Browse every folder in the library"),
        Tuple.Create("Recently Added", Url.Action("Index", "Recent"), "What's new lately"),
        Tuple.Create("Most Viewed", Url.Action("MostViewed", "Recent"), "The most watched files"),
        Tuple.Create("Favorites", Url.Action("Index", "Favorites"), "Files you've starred"),
        Tuple.Create("Tags", Url.Action("Index", "Tags"), "Find files by tag"),
        Tuple.Create("Add Media", Url.Action("AddMedia", "Media"), "Upload new files"),
    };
}

<style>
    .home-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 20px; }
    .home-tile { display: block; padding: 18px; border: 1px solid rgba(128,128,128,.35); border-radius: 8px; text-decoration: none !important; color: inherit; }
    .home-tile:hover, .home-tile:focus { border-color: #337ab7; background: rgba(51,122,183,.08); }
    .home-tile strong { display: block; font-size: 18px; margin-bottom: 4px; }
    .home-tile span { opacity: .75; }
</style>

<h2>@MediaManager.Models.SiteSettings.SiteName</h2>

<div class="home-tiles">
    @foreach (var t in tiles)
    {
        <a class="home-tile" href="@t.Item2"><strong>@t.Item1</strong><span>@t.Item3</span></a>
    }
</div>
