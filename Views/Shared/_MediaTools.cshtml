@*
    Shared pieces for pages that show and manage media (Gallery, View, Favorites, Storage Random, Flagged):
    security token, notification toast, Rename and Move / Copy dialogs, and the action URLs.
    The page must also load ~/Scripts/media-common.js in its scripts section (it needs jQuery).
*@
@Html.AntiForgeryToken()

<div id="toast"
     style="display:none; position:fixed; top:20px; right:20px; padding:10px 20px;
            background:#333; color:#fff; border-radius:6px; z-index:9999;">
</div>

<div id="renameModal" class="modal" style="display:none;">
    <div class="modal-content" style="padding:15px;">
        <h3>Rename File</h3>
        <input type="text" id="renameInput" autocomplete="off" style="width:100%; max-width:420px;" />
        <div style="margin-top:10px;">
            <button id="renameConfirmBtn">Rename</button>
            <button type="button" onclick="$('#renameModal').hide();">Cancel</button>
        </div>
    </div>
</div>

<div id="moveModal" class="modal" style="display:none;">
    <div class="modal-content" style="padding:15px;">
        <h3 id="moveTitle">Move File</h3>
        <p id="moveFileName" style="opacity:.8; word-break:break-all;"></p>
        <input type="text" id="moveInput" placeholder="Search folders, or type a new one" autocomplete="off"
               style="width:100%; max-width:420px;" />
        <div id="moveFolderList" class="move-folder-list"></div>
        <div id="moveHint" style="font-size:12px; opacity:.8; margin:4px 0 10px;"></div>
        <button id="moveConfirmBtn">Move</button>
        <button type="button" onclick="$('#moveModal').hide();">Cancel</button>
    </div>
</div>

<style>
    .move-folder-list {
        max-width: 420px;
        max-height: 240px;
        overflow-y: auto;
        margin-top: 4px;
        border: 1px solid rgba(127, 127, 127, .4);
        border-radius: 4px;
        text-align: left;
    }

    .move-folder-option {
        padding: 6px 8px;
        cursor: pointer;
        word-break: break-all;
    }

        .move-folder-option:hover {
            background: rgba(127, 127, 127, .25);
        }

    /* Tags: chips and the "Add a tag" box (MediaTools.tagEditor) */
    .tag-editor { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; justify-content: center; margin-top: 10px; }
    .tag-chips { display: contents; }
    .tag-chip {
        display: inline-flex; align-items: center; gap: 2px; padding: 1px 4px 1px 10px; border-radius: 12px;
        background: rgba(42, 122, 226, .18); border: 1px solid rgba(42, 122, 226, .5); font-size: 13px;
    }
    .tag-chip a { text-decoration: none; }
    .tag-chip .tag-x { border: 0; background: none; padding: 0 4px; line-height: 1; opacity: .7; cursor: pointer; }
    .tag-chip .tag-x:hover { opacity: 1; }
    .tag-none { opacity: .6; font-size: 13px; }
    .tag-input { width: 160px; padding: 2px 6px; }
    .tag-combo { position: relative; display: inline-block; }
    .tag-dropdown {
        position: absolute; top: 100%; left: 0; z-index: 1000; min-width: 100%; max-height: 240px; overflow-y: auto;
        margin: 2px 0 0; padding: 2px 0; list-style: none; text-align: left; font-size: 13px;
        background: #222; color: #eee; border: 1px solid #555; border-radius: 4px; box-shadow: 0 4px 12px rgba(0,0,0,.4);
    }
    .tag-dropdown li { padding: 4px 10px; cursor: pointer; white-space: nowrap; display: flex; justify-content: space-between; gap: 12px; }
    .tag-dropdown li:hover, .tag-dropdown li.active { background: rgba(42, 122, 226, .45); }
    .tag-dropdown .tag-count { opacity: .55; }
    .tag-dropdown .tag-new { font-style: italic; }
    .tag-list { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px; justify-content: center; }
    .tag-list .tag-chip { padding: 0 8px; font-size: 12px; }

    .favBtn.is-favorite {
        color: #f5c518;
    }
</style>

<script>
    // File extensions by kind (Models/Constants), so the browser shows each file the right way
    window.MEDIA_KINDS = @Html.Raw(Json.Encode(new
    {
        image = MediaManager.Models.Constants.Constants.ImageExtensions,
        video = MediaManager.Models.Constants.Constants.VideoExtensions,
        audio = MediaManager.Models.Constants.Constants.AudioExtensions,
        document = MediaManager.Models.Constants.Constants.DocumentExtensions
    }));

    // Videos browsers can't play, shown through an MP4 copy the server makes (Models/PlayableCopy.cs)
    window.MEDIA_PLAYABLE = @Html.Raw(Json.Encode(MediaManager.Models.PlayableCopy.Extensions));

    window.MEDIA_URLS = {
        rename: '@Url.Action("RenameMedia", "Media")',
        move: '@Url.Action("MoveMedia", "Media")',
        copy: '@Url.Action("CopyMedia", "Media")',
        tagsList: '@Url.Action("List", "Tags")',
        tagsForFile: '@Url.Action("ForFile", "Tags")',
        tagsAdd: '@Url.Action("Add", "Tags")',
        tagsRemove: '@Url.Action("Remove", "Tags")',
        tagsPage: '@Url.Action("Index", "Tags")',
        remove: '@Url.Action("DeleteMedia", "Media")',
        markCorrupted: '@Url.Action("MarkAsCorrupted", "Media")',
        unmark: '@Url.Action("UnmarkFile", "Media")',
        fix: '@Url.Action("FixCorruptedFile", "Media")',
        fixSeeking: '@Url.Action("FixSeeking", "Media")',
        saveRotated: '@Url.Action("SaveRotatedCopy", "Media")',
        saveSnapshot: '@Url.Action("SaveSnapshot", "Media")',
        playableStatus: '@Url.Action("Status", "Playable")',
        playableStart: '@Url.Action("Start", "Playable")',
        clearCache: '@Url.Action("ClearMediaCache", "Media")',
        folders: '@Url.Action("GetFolders", "Media")',
        view: '@Url.Action("ViewMedia", "Media")',
        gallery: '@Url.Action("Gallery", "Media")',
        links: '@Url.Action("Links", "Media")',
        mediaRoot: '@Url.Content(MediaManager.Models.MediaPaths.VirtualRoot)',
        hideNames: @(MediaManager.Models.HiddenNames.Enabled ? "true" : "false"),
        setFavorite: '@Url.Action("Set", "Favorites")',
        removeFavorite: '@Url.Action("Remove", "Favorites")',
        recordView: '@Url.Action("RecordView", "Media")'
    };
</script>
