@model MediaManager.Models.FileViewModel
@{
    ViewBag.Title = ViewBag.File;
    string folder = ViewBag.Folder;
    string file = ViewBag.File;
    string path = ViewBag.Url;
    string prev = ViewBag.Prev;
    string next = ViewBag.Next;
    bool isFavorite = ViewBag.IsFavorite == true;
    bool isCorrupted = ViewBag.IsCorrupted == true;

    string kind = MediaManager.Models.MediaPaths.KindOf(file);
    bool isVideo = kind == MediaManager.Models.MediaKind.Video;
    bool isAudio = kind == MediaManager.Models.MediaKind.Audio;
    bool canRotate = isVideo || kind == MediaManager.Models.MediaKind.Image;

    // Move / Rename / Delete / the Corrupted flag work on files inside a folder, not loose files at the very top
    bool hasFolder = folder.Length > 0;

    string prevLink = prev == null ? null : Url.ViewLink(folder, prev);
    string nextLink = next == null ? null : Url.ViewLink(folder, next);
    string galleryLink = hasFolder ? Url.GalleryLink(folder) : null;
}

<h2 style="word-break:break-all;">@file</h2>

<p>
    @if (hasFolder)
    {
        <u><a href="@galleryLink">← Back to Gallery</a></u>
    }
    else
    {
        <u>@Html.ActionLink("← Home", "Index", "Home")</u>
        <span style="opacity:.75; margin-left:8px;">This file is at the very top of the library, outside any folder.</span>
    }
</p>

@Html.Partial("_MediaTools")

<div class="view-nav" style="display:flex; justify-content:space-between; align-items:center; max-width:800px; margin:0 auto 10px;">
    @if (prev != null)
    {
        <a id="prevLink" href="@prevLink" title="Previous (Left arrow)">&#9664; Previous</a>
    }
    else
    {
        <span style="opacity:.4;">&#9664; Previous</span>
    }
    <span style="opacity:.8;">@ViewBag.Position of @Model.FilesInDirectory</span>
    @if (next != null)
    {
        <a id="nextLink" href="@nextLink" title="Next (Right arrow)">Next &#9654;</a>
    }
    else
    {
        <span style="opacity:.4;">Next &#9654;</span>
    }
</div>

@* Filled in by media-common.js: picture, video / audio player, PDF viewer, text, or a document card *@
<div class="media-player" style="text-align:center;" data-src="@path" data-file="@file" data-folder="@folder" data-id="mediaElement"
     data-fallback="@ViewBag.Fallback"
     data-autoplay="@((isVideo || isAudio) ? "true" : "false")" data-max-height="80vh"></div>

@if (canRotate)
{
    <div class="rotate-actions" style="text-align:center; margin-top:8px;">
        <button id="rotateLeftBtn" title="Rotate left (Shift+R). Only changes how it's shown here; the file isn't changed.">&#10226; Rotate left</button>
        <button id="rotateRightBtn" title="Rotate right (R). Only changes how it's shown here; the file isn't changed.">&#10227; Rotate right</button>
        <button id="saveRotatedBtn" style="display:none;"
                title="Save a new file turned the way it's shown now, next to this one. This file isn't changed.">Save rotated copy</button>
    </div>
    <div class="snapshot-actions" style="text-align:center; margin-top:8px;">
        @if (isVideo)
        {
            <button id="frameBackBtn" title="Back one frame (, key). Pauses the video.">&#9664;&#10073; Frame</button>
            <button id="frameForwardBtn" title="Forward one frame (. key). Pauses the video.">Frame &#10073;&#9654;</button>
        }
        <button id="snapshotBtn"
                title="@(isVideo ? "Save the frame showing now as a full-size JPEG next to this video" : "Save this picture as it's shown now (turned too) as a full-size JPEG next to it") (S key)">&#128247; Save snapshot</button>
    </div>
}

<div class="media-actions" style="text-align:center; margin-top:12px;">
    <button id="favBtn" class="favBtn@(isFavorite ? " is-favorite" : "")" data-favorite="@(isFavorite ? "true" : "false")">
        @Html.Raw(isFavorite ? "&#9733; Favorite" : "&#9734; Favorite")
    </button>
    @if (hasFolder)
    {
        <button id="moveBtn">Move</button>
    }
    <button id="copyBtn">Copy</button>
    @if (hasFolder)
    {
        <button id="renameBtn">Rename</button>
        if (isCorrupted)
        {
            if (isVideo)
            {
                <button id="fixBtn">Fix File</button>
            }
            <button id="unmarkBtn" title="Clear the Corrupted flag">Unmark Corrupted</button>
        }
        else
        {
            <button id="corruptedBtn">Mark Corrupted</button>
        }
    }
    @if (MediaManager.Models.VideoIndex.CanFix(System.IO.Path.GetExtension(file)))
    {
        <button id="fixSeekingBtn" title="For videos you can't skip through in Photos / Media Player. No quality is lost.">Fix Seeking</button>
    }
    @if (hasFolder)
    {
        <button id="deleteBtn">Delete</button>
    }
    <a href="@path" download="@file" style="margin-left:6px;">Download</a>
</div>

@* Filled in by MediaTools.tagEditor: this file's tags and a box to add one *@
<div id="tagEditor"></div>

<div class="file-info" style="max-width:600px; margin:25px auto 0; padding:15px; border:1px solid #ccc; border-radius:6px;">
    <h4 style="margin-top:0;">File info</h4>
    <table class="table table-condensed" style="margin-bottom:0;">
        <tr><th style="width:150px;">Name</th><td style="word-break:break-all;">@Model.FileName</td></tr>
        <tr><th>Folder</th><td style="word-break:break-all;">@if (hasFolder) { <a href="@galleryLink">@folder</a> } else { <text>(top folder)</text> }</td></tr>
        <tr><th>Type</th><td>@Model.FileType (@Model.FileExtension.ToLowerInvariant())</td></tr>
        @if (ViewBag.RealFormat != null)
        {
            var real = (MediaManager.Models.FileFormat.Info)ViewBag.RealFormat;
            <tr>
                <th>Actual format</th>
                <td>
                    <strong>@real.Name</strong>, though it's named @Model.FileExtension.ToLowerInvariant()
                    @if (!real.BrowsersShow)
                    {
                        <br /><small style="opacity:.8;">Browsers can't show @real.Name, so the picture above is a copy the site converted to JPEG. The file itself is unchanged.</small>
                    }
                </td>
            </tr>
        }
        <tr><th>Size</th><td>@Model.FileSizeFormatted <span style="opacity:.7;">(@Model.FileSize.ToString("N0") bytes)</span></td></tr>
        <tr id="dimensionsRow" style="display:none;"><th>@(isVideo ? "Resolution" : "Dimensions")</th><td id="dimensions"></td></tr>
        @if (isVideo || isAudio)
        {
            <tr id="durationRow" style="display:none;"><th>Length</th><td id="duration"></td></tr>
        }
        <tr><th>Created</th><td>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td></tr>
        <tr><th>Modified</th><td>@Model.LastModified.ToString("yyyy-MM-dd HH:mm")</td></tr>
        <tr><th>Files in folder</th><td>@Model.FilesInDirectory</td></tr>
        <tr><th>Views</th><td title="Times this file's page was opened (once per 30 minutes per browser)">@(ViewBag.Views ?? 0) &middot; @Html.ActionLink("Most viewed", "MostViewed", "Recent")</td></tr>
        <tr><th>Path</th><td style="word-break:break-all; opacity:.8;">@Model.FullPath</td></tr>
    </table>
    <p style="margin:10px 0 0; font-size:12px; opacity:.7;">
        Keys: &larr; / &rarr; previous / next@(canRotate ? ", R / Shift+R rotate right / left" : "")@(isVideo ? ", , / . frame back / forward" : "")@(canRotate ? ", S save snapshot" : "")@((isVideo || isAudio) ? ", J / K / L back 10s / play-pause / forward 10s" : "")
    </p>
</div>

@section scripts {
    <script src="@Url.Versioned("~/Scripts/media-common.js")"></script>
    <script>
        (function () {
            const T = window.MediaTools;
            const folder = @Html.Raw(Json.Encode(folder));
            const file = @Html.Raw(Json.Encode(file));
            const prevLink = @Html.Raw(Json.Encode(prevLink));
            const nextLink = @Html.Raw(Json.Encode(nextLink));
            const galleryLink = @Html.Raw(Json.Encode(galleryLink ?? Url.Action("Index", "Home")));

            // After Move / Delete, carry on with the next file (or previous, or back to the gallery)
            function goOn() {
                window.location.replace(nextLink || prevLink || galleryLink);
            }

            $('#favBtn').on('click', function () {
                const $btn = $(this);
                const makeFavorite = $btn.attr('data-favorite') !== 'true';
                T.setFavorite(folder, file, makeFavorite).then(fav => {
                    $btn.attr('data-favorite', fav ? 'true' : 'false')
                        .toggleClass('is-favorite', fav)
                        .html(fav ? '&#9733; Favorite' : '&#9734; Favorite');
                }, () => { });
            });

            $('#moveBtn').on('click', () => T.move(folder, file).then(goOn));
            $('#copyBtn').on('click', () => T.copy(folder, file));
            T.tagEditor(document.getElementById('tagEditor'), folder, file);
            $('#deleteBtn').on('click', () => T.remove(folder, file).then(goOn));
            $('#renameBtn').on('click', () => T.rename(folder, file).then(newName =>
                T.go(folder, newName, { replace: true })));

            $('#corruptedBtn').on('click', () => T.markCorrupted(folder, file).then(() => location.reload()));

            $('#unmarkBtn').on('click', () => T.unmark(folder, file).then(() => location.reload(), () => { }));

            $('#fixBtn').on('click', function () {
                const $btn = $(this);
                T.fix(folder, file, () => T.busy($btn, 'Fixing...')).then(
                    fixed => { if (fixed) T.reloadWithMessage('Fixed: this is the repaired file playing now.'); },
                    () => T.idle($btn));
            });

            // Rewrites the video with a proper index. The player lets go of the file first, so it can be replaced.
            $('#fixSeekingBtn').on('click', function () {
                if (!confirm('Fix "' + file + '" so you can skip through it in any video player?\n\n' +
                    'The video and audio are copied as they are (no quality is lost). This takes a few seconds for most videos.')) return;
                T.busy($(this), 'Fixing...');
                const player = document.getElementById('mediaElement');
                if (player && player.tagName === 'VIDEO') {
                    player.pause();
                    player.querySelectorAll('source').forEach(s => s.remove());
                    player.load();
                }
                T.showToast('Fixing, please wait...');
                T.fixSeeking(folder, file).then(
                    res => T.reloadWithMessage(res.message),
                    () => location.reload()); // the error was shown; bring the player back
            });

            // Left / right arrow keys: previous / next file
            document.addEventListener('keydown', function (e) {
                if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) return;
                if ($('#renameModal').is(':visible') || $('#moveModal').is(':visible')) return;
                if (e.key === 'ArrowLeft' && prevLink) window.location.href = prevLink;
                if (e.key === 'ArrowRight' && nextLink) window.location.href = nextLink;
                if (e.ctrlKey || e.metaKey || e.altKey) return;
                if (e.key === 'r' || e.key === 'R') rotateBy(e.shiftKey ? -90 : 90);
                if (e.key === ',') stepFrame(-1);
                if (e.key === '.') stepFrame(1);
                if (e.key === 's' || e.key === 'S') $('#snapshotBtn:enabled').click();
            });

            // Videos: step one frame at a time to find the one you want, then save it as a picture.
            // Browsers don't say a video's frame rate, so a step is 1/30 s (one frame of most phone videos).
            const FRAME = 1 / 30;
            function currentVideo() {
                const el = document.getElementById('mediaElement');
                return el && el.tagName === 'VIDEO' ? el : null; // an AVI's player isn't there until its copy is ready
            }

            function stepFrame(dir) {
                const v = currentVideo();
                if (!v) return;
                v.pause();
                v.currentTime = Math.min(Math.max(0, v.currentTime + dir * FRAME), v.duration || Infinity);
            }

            $('#frameBackBtn').on('click', () => stepFrame(-1));
            $('#frameForwardBtn').on('click', () => stepFrame(1));

            // Made on the server from the file itself, at full size and turned the way it's shown here.
            // Videos: the frame showing (ffmpeg). Pictures: the picture, as a JPEG.
            $('#snapshotBtn').on('click', function () {
                const data = { folder, fileName: file, degrees: ((angle % 360) + 360) % 360 };
                if (@Html.Raw(isVideo ? "true" : "false")) {
                    const v = currentVideo();
                    if (!v) { T.showToast('Wait until the video is ready to play.'); return; }
                    data.seconds = v.currentTime.toFixed(3);
                }
                const $btn = $(this);
                T.busy($btn, 'Saving...');
                T.post(window.MEDIA_URLS.saveSnapshot, data).then(
                    res => { T.idle($btn); T.showToast('Saved "' + res.newName + '"', 4000); },
                    () => T.idle($btn));
            });

            // Rotate the picture / video on screen only (the file isn't changed). Sideways, it's resized so it still
            // fits the page: the element keeps its unrotated size, and margins make room for its rotated shape.
            let angle = 0; // keeps counting past 360 so each turn animates the short way
            let plainStyle = null; // the player's own style, put back at 0°

            function applyRotation() {
                const el = document.getElementById('mediaElement');
                if (!el || (el.tagName !== 'IMG' && el.tagName !== 'VIDEO')) return;
                if (plainStyle === null) plainStyle = el.getAttribute('style') || '';
                if (angle % 360 === 0) {
                    el.setAttribute('style', plainStyle);
                    Object.assign(el.style, { transform: 'rotate(' + angle + 'deg)', transition: 'transform .2s' });
                    return;
                }

                const w = el.naturalWidth || el.videoWidth, h = el.naturalHeight || el.videoHeight;
                if (!w || !h) return; // not loaded yet; runs again once it is
                const sideways = Math.abs(angle) % 180 === 90;
                const shownW = sideways ? h : w, shownH = sideways ? w : h;
                const room = el.closest('.media-player');
                const scale = Math.min(1, room.clientWidth / shownW, window.innerHeight * 0.8 / shownH);
                const elW = w * scale, elH = h * scale;

                Object.assign(el.style, {
                    display: 'block', maxWidth: 'none', maxHeight: 'none',
                    width: elW + 'px', height: elH + 'px',
                    margin: ((shownH * scale - elH) / 2) + 'px auto',
                    transform: 'rotate(' + angle + 'deg)', transition: 'transform .2s'
                });
            }

            function rotateBy(deg) {
                angle += deg;
                applyRotation();
                $('#saveRotatedBtn').toggle(angle % 360 !== 0);
            }

            // Writes "name (rotated).ext" next to this file, then opens it. MP4 / MOV and pictures are quick;
            // WebM / AVI are re-encoded to MP4, which takes a while for long videos.
            $('#saveRotatedBtn').on('click', function () {
                const $btn = $(this);
                const turn = ((angle % 360) + 360) % 360;
                const ext = file.slice(file.lastIndexOf('.')).toLowerCase();
                const slow = @Html.Raw(isVideo ? "true" : "false") && ext !== '.mp4' && ext !== '.mov';
                if (!confirm('Save a copy of "' + file + '" turned ' + turn + '° clockwise?\n\n' +
                    'It\'s saved next to this one as a new file; this file isn\'t changed.' +
                    (slow ? '\n\nThis video has to be converted to MP4 to turn it, which can take a few minutes for long videos.' : ''))) return;

                T.busy($btn, 'Saving...');
                if (slow) T.showToast('Converting, please wait...', 10000);
                T.post(window.MEDIA_URLS.saveRotated, { folder, fileName: file, degrees: turn }).then(
                    res => T.links(folder, res.newName).then(
                        l => T.goWithMessage(l.view, 'Saved the rotated copy as "' + res.newName + '".'),
                        () => T.idle($btn)),
                    () => T.idle($btn));
            });

            $('#rotateLeftBtn').on('click', () => rotateBy(-90));
            $('#rotateRightBtn').on('click', () => rotateBy(90));
            window.addEventListener('resize', applyRotation);

            function watchPlayer() {
                const el = document.getElementById('mediaElement');
                if (!el) return;
                plainStyle = null; // an AVI's playable copy is a new element
                el.addEventListener(el.tagName === 'VIDEO' ? 'loadedmetadata' : 'load', applyRotation); // also a JPEG fallback swapping in
                applyRotation();
            }
            watchPlayer();
            document.addEventListener('mediatools:playerready', watchPlayer);

            // Dimensions / video length come from the browser once the file has loaded
            function showDimensions(w, h) {
                if (!w || !h) return;
                document.getElementById('dimensions').textContent = w + ' × ' + h + ' px';
                document.getElementById('dimensionsRow').style.display = '';
            }

            function formatDuration(sec) {
                sec = Math.round(sec);
                const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
                return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0');
            }

            function readDetails() {
                const el = document.getElementById('mediaElement');
                if (!el) return;
                if (el.tagName === 'VIDEO' || el.tagName === 'AUDIO') {
                    const onMeta = () => {
                        if (el.tagName === 'VIDEO') showDimensions(el.videoWidth, el.videoHeight);
                        if (isFinite(el.duration)) {
                            document.getElementById('duration').textContent = formatDuration(el.duration);
                            document.getElementById('durationRow').style.display = '';
                        }
                    };
                    if (el.readyState >= 1) onMeta(); else el.addEventListener('loadedmetadata', onMeta);
                } else if (el.tagName === 'IMG') {
                    if (el.complete) showDimensions(el.naturalWidth, el.naturalHeight);
                    else el.addEventListener('load', () => showDimensions(el.naturalWidth, el.naturalHeight));
                }
            }

            readDetails();
            document.addEventListener('mediatools:playerready', readDetails); // an AVI's playable copy took its place
        })();
    </script>
}
